<script>

let characteristic = null;


/* =========================
   BLUETOOTH
   ========================= */

function connect() {

    navigator.bluetooth.requestDevice({

        filters: [
            {
                name: "w32 ControlHub"
            }
        ],

        optionalServices: [
            "d9d9e9e0-aa4e-4797-8151-cb41cedaf2ad"
        ]

    })

    .then(device => {

        return device.gatt.connect();

    })

    .then(server => {

        return server.getPrimaryService(
            "d9d9e9e0-aa4e-4797-8151-cb41cedaf2ad"
        );

    })

    .then(async service => {

        characteristic =
            await service.getCharacteristic(
                "d9d9e9e1-aa4e-4797-8151-cb41cedaf2ad"
            );

        document.getElementById("status").innerText =
            "CONNECTED";

        stop();

    })

    .catch(error => {

        console.log(error);

        document.getElementById("status").innerText =
            "Connection failed";

    });

}


/* =========================
   SEND BLUETOOTH COMMAND
   ========================= */

async function writeToChar(value) {

    if (!characteristic) return;

    let bytes = hexToBytes(value);

    let data =
        new Uint8Array(bytes).buffer;

    try {

        await characteristic.writeValue(data);

    } catch(error) {

        console.log(error);

    }

}


/* =========================
   HEX CONVERTER
   ========================= */

function hexToBytes(hex) {

    let bytes = [];

    for (
        let c = 0;
        c < hex.length;
        c += 2
    ) {

        bytes.push(
            parseInt(
                hex.substr(c, 2),
                16
            )
        );

    }

    return bytes;
}


