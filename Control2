    "thinking":
    "1E0100E1F0"
};


async function play(sound) {

    await writeToChar(sound);
}


function makeSoundButtons() {

    const div =
        document.getElementById("buttonsDiv");

    for (
        const [name, command]
        of Object.entries(sounds)
    ) {

        const button =
            document.createElement("button");

        button.innerText = name;

        button.onclick =
            () => play(command);

        div.appendChild(button);
    }
}


/* =========================
   STARTUP
   ========================= */

window.onload = function() {

    makeSoundButtons();

    new JoystickController(
        "stick1",
        64,
        8
    );

};

</script>

