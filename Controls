    /* =========================
       JOYSTICK
       ========================= */

    class JoystickController {

      constructor(stickID, maxDistance, deadzone) {

        this.id = stickID;

        let stick = document.getElementById(stickID);

        this.dragStart = null;
        this.touchId = null;
        this.active = false;

        this.value = {
          x: 0,
          y: 0
        };

        let self = this;


        function handleDown(event) {

          self.active = true;

          stick.style.transition = '0s';

          event.preventDefault();

          if (event.changedTouches) {

            self.dragStart = {
              x: event.changedTouches[0].clientX,
              y: event.changedTouches[0].clientY
            };

          } else {

            self.dragStart = {
              x: event.clientX,
              y: event.clientY
            };
          }

          if (event.changedTouches) {
            self.touchId =
              event.changedTouches[0].identifier;
          }
        }


        function handleMove(event) {

          if (!self.active) return;

          if (!characteristic) return;


          /* Touch handling */

          if (event.changedTouches) {

            let found = false;

            for (
              let i = 0;
              i < event.changedTouches.length;
              i++
            ) {

              if (
                self.touchId ===
                event.changedTouches[i].identifier
              ) {

                event.clientX =
                  event.changedTouches[i].clientX;

                event.clientY =
                  event.changedTouches[i].clientY;

                found = true;

                break;
              }
            }

            if (!found) return;
          }


          /* Calculate movement */

          const xDiff =
            event.clientX -
            self.dragStart.x;

          const yDiff =
            event.clientY -
            self.dragStart.y;


          const angle =
            Math.atan2(yDiff, xDiff);


          const distance =
            Math.min(
              maxDistance,
              Math.hypot(xDiff, yDiff)
            );


          const xPosition =
            distance * Math.cos(angle);

          const yPosition =
            distance * Math.sin(angle);


          /* Move joystick graphic */

          stick.style.transform =
            `translate3d(
              ${xPosition}px,
              ${yPosition}px,
              0px
            )`;


          /* Deadzone */

          const distance2 =
            (distance < deadzone)
              ? 0
              : maxDistance /
                (maxDistance - deadzone) *
                (distance - deadzone);


          const xPosition2 =
            distance2 * Math.cos(angle);

          const yPosition2 =
            distance2 * Math.sin(angle);


          const xPercent =
            parseFloat(
              (xPosition2 / maxDistance)
              .toFixed(4)
            );


          const yPercent =
            parseFloat(
              (yPosition2 / maxDistance)
              .toFixed(4)
            );


          self.value = {
            x: xPercent,
            y: yPercent
          };


          /*
           * =========================
           * FIXED DRIVE MAPPING
           * =========================
           *
           * Joystick UP:
           *   driveValues 31 -> 0
           *
           * Center:
           *   driveValues 31
           *
           * Joystick DOWN:
           *   driveValues 31 -> 62
           *
           * Left/right:
           *   turn only
           */


          let xVal;
          let yVal;


          /*
           * If the joystick is primarily
           * vertical, drive forward/backward.
           */

          if (
            Math.abs(yPercent) >=
            Math.abs(xPercent)
          ) {

            /* Straight */

            xVal = 16;


            /*
             * UP = forward
             *
             * yPercent:
             *   0 = center
             *  -1 = full up
             */

            yVal =
              31 +
              (31 * yPercent);


          } else {

            /*
             * Primarily horizontal:
             * turn without driving.
             */

            yVal = 31;


            /*
             * xPercent:
             *  -1 = left
             *   0 = center
             *  +1 = right
             */

            xVal =
              16 +
              (15 * xPercent);
          }


          /*
           * Keep values inside valid ranges.
           */

          x =
            Math.max(
              1,
              Math.min(
                32,
                Math.floor(xVal)
              )
            );


          y =
            Math.max(
              0,
              Math.min(
                62,
                Math.floor(yVal)
              )
            );


          /*
           * Send command.
           */

          throttle(
            () => driveAndTurn()
          );
        }


        function handleUp(event) {

          if (!self.active) return;


          if (
            event.changedTouches &&
            self.touchId !==
            event.changedTouches[0].identifier
          ) {
            return;
          }


          /* Return joystick to center */

          stick.style.transition = '.2s';

          stick.style.transform =
            'translate3d(0px,0px,0px)';


          /* Reset */

          self.value = {
            x: 0,
            y: 0
          };

          self.touchId = null;

          self.active = false;


          /* Stop R2-D2 */

          stop();
        }


        stick.addEventListener(
          'mousedown',
          handleDown
        );

        stick.addEventListener(
          'touchstart',
          handleDown
        );

        document.addEventListener(
          'mousemove',
          handleMove,
          {passive:false}
        );

        document.addEventListener(
          'touchmove',
          handleMove,
          {passive:false}
        );

        document.addEventListener(
          'mouseup',
          handleUp
        );

        document.addEventListener(
          'touchend',
          handleUp
        );
      }
    }


    /*
     * Send turn and drive.
     */

    function driveAndTurn() {

      if (!characteristic) return;

      if (x !== undefined) {
        turn(x);
      }

      setTimeout(
        () => {
          if (y !== undefined) {
            drive(y);
          }
        },
        100
      );
    }

  </script>
