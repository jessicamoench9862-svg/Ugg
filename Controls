  <script>
    var characteristic;

    function connect() {
      navigator.bluetooth.requestDevice({
        filters: [{"name":"w32 ControlHub"}],
        optionalServices: [
          'd9d9e9e0-aa4e-4797-8151-cb41cedaf2ad'
        ]
      })
      .then(device => {
        return device.gatt.connect();
      })
      .then(server => {
        return server.getPrimaryService(
          'd9d9e9e0-aa4e-4797-8151-cb41cedaf2ad'
        );
      })
      .then(async service => {
        characteristic = await service.getCharacteristic(
          "d9d9e9e1-aa4e-4797-8151-cb41cedaf2ad"
        );
      })
      .then(() => {
        console.log('Connected!');
        stop();
      });
    }

    async function writeToChar(value) {
      if (!characteristic) return;

      value = hexToBytes(value);
      value = new Uint8Array(value).buffer;

      try {
        await characteristic.writeValue(value);
      } catch(e) {
        console.log("Bluetooth write error:", e);
      }
    }

    async function play(sound) {
      try {
        await writeToChar(sound);
      } catch(error) {
        console.log('Argh! ' + error);
      }
    }

    async function drive(index) {
      try {
        await writeToChar(driveValues[index]);
      } catch(error) {
        console.log('Argh! ' + error);
      }
    }

    async function turn(index) {
      try {
        await writeToChar(turnValues[index]);
      } catch(error) {
        console.log('Argh! ' + error);
      }
    }

    async function stop() {
      try {
        x = 16;
        y = 31;

        driveAndTurn();
      } catch(error) {
        console.log('Argh! ' + error);
      }
    }

    function hexToBytes(hex) {
      for (
        var bytes = [],
        c = 0;
        c < hex.length;
        c += 2
      )
        bytes.push(
          parseInt(hex.substr(c, 2), 16)
        );

      return bytes;
    }


